# Copy to .env and adjust for your local setup:  cp .env.example .env
# .env is git-ignored — never commit real credentials.

# --- Database ---
# If you already run a local Postgres on 5432, publish the container on 5433
# (docker run -p 5433:5432 ...) and set DB_PORT=5433 — a loopback-bound local
# server otherwise wins over the container's wildcard bind for "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_USER=expense
DB_PASSWORD=expense
DB_NAME=expense_tracker

# --- HTTP server ---
HTTP_PORT=8080

# --- Auth ---
# Local development placeholder. Generate a real one per environment:
#   openssl rand -base64 32
JWT_SECRET=dev-secret-change-me
